{
  "name": "stocks-analysis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "server:watch": "node --watch server/index.js",
    "client": "cd client && npm run dev",
    "dev:all": "concurrently \"npm run server\" \"npm run client\"",
    "dev:all:watch": "concurrently \"npm run server:watch\" \"npm run client\"",
    "load": "node scripts/loadCsv.js",
    "ema": "node scripts/ema.js",
    "momentum": "node scripts/momentum.js",
    "analyze": "node scripts/analyze.js",
    "entries": "node scripts/findEntries.js",
    "kite:login": "node scripts/kiteLogin.js",
    "kite:session": "node scripts/kiteSession.js",
    "kite:history": "node scripts/kiteHistorical.js",
    "kite:ohlc": "node scripts/kiteOHLC.js",
    "pre-market": "node scripts/preMarket.js",
    "fetch3m": "node scripts/fetchPrevDay3m.js",
    "analyze:otc": "node v2/scripts/analyzeOpenToCloseSurge.js",
    "prereq": "node v2/scripts/loadPrereqData.js",
    "order:one": "node scripts/placeOneOrder.js",
    "live": "node scripts/liveScanner.js",
    "positions": "node scripts/positionManager.js",
    "v3:fetch": "node v3/scripts/fetchV3Data.js",
    "v3:fetch:watchlist": "node v3/scripts/fetchV3Data.js --all --force",
    "v3:fetch:universe": "node v3/scripts/fetchV3Data.js --all --force --universe",
    "v3:backtest": "node v3/scripts/runBacktest.js",
    "v3:scan:refresh": "node v3/scripts/swingScanner.js --refresh",
    "v3:scan:premarket": "node v3/scripts/swingScanner.js --refresh",
    "v3:scan:hourly": "node v3/scripts/swingScanner.js --hourly",
    "v3:scan:exits": "node v3/scripts/swingScanner.js --exits",
    "v3:scan:daemon": "node v3/scripts/swingScanner.js --daemon",
    "v3:scan:universe": "node v3/scripts/swingScanner.js --hourly --universe",
    "v3:scan:universe:daemon": "node v3/scripts/swingScanner.js --daemon --universe"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "kiteconnect": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
