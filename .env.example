# Zerodha Kite Connect — copy to .env and fill in
# API key & secret: https://kite.zerodha.com/apps
# Request token: run "npm run kite:login", open the URL, log in; script prints request_token for .env
# (Redirect URL in Kite app must be http://127.0.0.1:3000 or set KITE_REDIRECT_PORT)

KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
KITE_REQUEST_TOKEN=your_request_token

# Telegram alerts (optional). Create bot via @BotFather; get chat ID from getUpdates after messaging the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live trading: set to true to place real orders when a signal fires (default false = paper only).
LIVE_TRADING=false

# Optional: min entry-bar volume / consolidation avg volume (e.g. 2.5). Skip reversal breakout if below.
# MIN_VOLUME_RATIO=2.5

# Optional: skip reversal breakout if day opened with gap up >= this % above previous close.
# Use 2 so minimal gaps (e.g. ~1%) like GODFRYPHLP are still allowed; 1 is strict.
# GAP_UP_THRESHOLD_PCT=2

# Optional: skip reversal breakout if entry candle range (high-low)/open > this %. Default 1.5 (avoids wide SL).
# MAX_ENTRY_CANDLE_RANGE_PCT=1.5

# Optional: skip reversal breakout if SL (entry - stop) as % of entry > this. Default 2 (e.g. 2% max risk).
# MAX_SL_PCT=2

# Reversal breakout: daily volume (so far at entry time) must be > previous day's volume (always applied).

# Optional: skip reversal breakout if pullback from move high to consolidation low > this %. Default 5.
# MAX_PULLBACK_PCT=5

# Optional: skip reversal breakout if consolidation range (high-low)/high > this %. Default 2.
# MAX_CONSOLIDATION_RANGE_PCT=2

# Live scanner: append events to a log file for debugging when away. Default on; log file: data/live_scanner.log
# Set LIVE_SCANNER_LOG=0 to disable. Set LOG_PATH to use a different file (e.g. logs/scanner.log).
# LIVE_SCANNER_LOG=1
# LOG_PATH=data/live_scanner.log

# v2 breakout: first bar index where entries are evaluated (3m bars from open). 11 ≈ ~09:48; 20 ≈ ~10:18.
# Same for CLI backtest and live scanner. Code default is 11 unless you override.
# MOVE_WINDOW_BARS=11

# v2 backtest fetch: max Kite historical API call starts per second (default 3).
# V2_KITE_HISTORICAL_RPS=3

# Dashboard POST /api/load-date only: historical RPS (default 5 if unset). Overrides V2_ for that spawn when set.
# LOAD_DATE_HISTORICAL_RPS=5
